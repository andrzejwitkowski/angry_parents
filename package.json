{
  "name": "tmp_app",
  "private": true,
  "version": "0.3.1-SNAPSHOT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:backend": "bun --watch backend/src/index.ts",
    "dev:all": "bun scripts/dev-all.ts",
    "dev:all-clear": "bun scripts/dev-all.ts --clear",
    "dev:all-clear-demo": "bun scripts/dev-all.ts --clear --demo",
    "dev:stop": "bun scripts/db-compose.ts down",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "prepare": "bun scripts/install-git-hooks.ts",
    "test": "bun test --exclude tests/e2e-backend",
    "test:integration": "INTEGRATION_TEST=true bun test backend/test/auth-integration.test.ts",
    "test:e2e": "E2E_TEST=true bun test tests/e2e-backend",
    "test:all": "E2E_TEST=true INTEGRATION_TEST=true bun test",
    "commit:check": "bun scripts/release/commit-policy.ts check-head",
    "version:check": "bun scripts/release/check-version-mode.ts",
    "release:bump": "bun scripts/release/versioning.ts bump",
    "preview": "vite preview"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "@simplewebauthn/typescript-types": "^8.3.4",
    "@types/mongodb": "^4.0.7",
    "@types/nodemailer": "^7.0.11",
    "autoprefixer": "^10.4.23",
    "better-auth": "^1.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "elysia": "^1.4.22",
    "framer-motion": "^12.29.2",
    "i18next": "^25.8.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.563.0",
    "mongodb": "^7.1.0",
    "mongoose": "^9.1.6",
    "nodemailer": "^8.0.1",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^16.5.3",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "3",
    "tailwindcss-animate": "^1.0.7",
    "viem": "^2.45.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.6",
    "@types/node": "^25.3.2",
    "@types/path-browserify": "^1.0.3",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cypress": "^15.9.0",
    "esbuild": "0.27.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "mongodb-memory-server": "^11.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}
