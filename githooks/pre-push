#!/usr/bin/env sh
set -eu

remote_name="$1"
remote_url="$2"

has_checked_ref=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ -z "$remote_ref" ]; then
    continue
  fi

  case "$remote_ref" in
    refs/heads/*)
      branch_name=${remote_ref#refs/heads/}
      has_checked_ref=1
      echo "Checking version mode for push to '$branch_name' via $remote_name ($remote_url)"
      bun run version:check --branch "$branch_name"
      ;;
  esac
done

if [ "$has_checked_ref" -eq 0 ]; then
  echo "Skipping version mode check because no branch refs are being pushed."
fi
